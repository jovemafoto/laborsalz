# Public studio identity
NEXT_PUBLIC_SITE_URL=https://ai.laborsalz.com
NEXT_PUBLIC_STUDIO_NAME=LaborSalz AI Studio

# Generation platform
# Optional override; defaults to https://platform.higgsfield.ai
HF_API_BASE_URL=https://platform.higgsfield.ai
LABORSALZ_AI_API_KEY=

# Internal API v2 authentication
# Generate with: openssl rand -hex 32
LABORSALZ_INTERNAL_API_TOKEN=

# LaborSalz local persistence
LABORSALZ_STORAGE_ROOT=/data
LABORSALZ_AI_STORAGE_HOST="/Volumes/LaborSalz-Data/03. Projects/LaborSalz AI Studio/04. Assets/runtime"
LABORSALZ_AI_PORT=3010
LABORSALZ_UPLOAD_MAX_MB=95
LABORSALZ_HISTORY_LIMIT=1000

# HMAC signing for provider-readable media URLs.
# Generate with: openssl rand -hex 32
LABORSALZ_MEDIA_SIGNING_SECRET=

# Optional: n8n webhook that receives studio lifecycle events.
N8N_EVENT_WEBHOOK_URL=
